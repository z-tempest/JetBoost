def add_expanding_pca(df):
    sensor_cols = df.columns[4:25]
    vals_all = df[sensor_cols].to_numpy()
    out = np.full(len(df), np.nan)

    for positions in df.groupby(level=0).indices.values():
        vals = vals_all[positions]
        for i in range(1, len(vals)):
            window = vals[:i+1]
            scaled = StandardScaler().fit_transform(window)
            p = PCA(n_components=2)
            p.fit(scaled)
            out[positions[i]] = p.transform(scaled[-1:])[0, 1]

    result = df.copy()
    result.insert(len(result.columns) - 2, 'pc2', out)
    return result


