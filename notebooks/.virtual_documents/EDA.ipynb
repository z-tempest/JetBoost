def split_condition(df):
    """Datasets FD002 and FD003 have six unique opperating conditions.
    This function splits the DataFrame by those individual operating conditions,
    For better degradation chart viewing.

    Args:
        df (pandas.DataFrame): Target dataframe to split conditions on.

    returns:
        condition_n: Augmented dataframe with n condition detached from the rest.
    """

    if df.equals(train2) or df.equals(train4):
        pass  # continue if the DataFrame has more than one operating condition
    else:
        print("Dataset must have more than one opperated condition")
        return

    con1, con2, con3, con4, con5, con6 = df.groupby(
        [df["Setting1"].round(), df["Setting2"].round(), df["Setting3"].round()],
        sort=True
    )

    return (
        con1[1],
        con2[1],
        con3[1],
        con4[1],
        con5[1],
        con6[1]
    )


def rtf_view(df, title, fault_modes=1):
    """ Run-to-failure degradation chart: many units decaying to a failure point.
        Failure markers ('X') are colored by each unit's PC2 value at the
        moment of failure, to visually surface whether failure clusters
        correspond to a secondary signal (e.g. a second fault mode) that
        PC1 alone doesn't separate. Units that haven't actually failed yet
        (the dataframe just runs out, e.g. a truncated test-set run) get
        no endpoint marker at all - the line simply stops.

        Args:
            df (pandas.DataFrame): Target df to view degradation charts.
            title (string): Title of the dataset.
            fault_modes (integer): Number of distinct fault modes present.
    """

    sensors = eda_utils.dropcols(df).apply(zscore).dropna(axis=1)

    pca_df = eda_utils.sensor_pca(sensors, n_components=2)

    engine_pc1 = pca_df.groupby("Engine")["Principal Component Sensors (PC1)"].agg(list)
    engine_pc2 = pca_df.groupby("Engine")["Principal Component Sensors (PC2)"].agg(list)

    engine_last_rul = df.groupby("Engine")["RUL"].last()

    fig = go.Figure()

    fail_x, fail_y, fail_color = [], [], []
    censored_count = 0

    for engine_id, pc1_health, pc2_health in zip(engine_pc1.index, engine_pc1, engine_pc2):
        life = len(pc1_health)
        cycles = np.arange(1, life + 1)

        fig.add_scatter(
            x=cycles,
            y=pc1_health,
            mode="lines",
            line=dict(color="rgba(70,150,190,0.5)", width=1),
            hoverinfo="skip",
            showlegend=False,
        )

        last_rul = engine_last_rul.get(engine_id, np.nan)
        # RUL == 0 (or unknown, per the fallback above) means the readout
        # actually ends in failure. RUL > 0 means the dataframe just stops
        # there (censored) - the unit hadn't failed yet, so no marker.
        has_failed = pd.isna(last_rul) or last_rul <= 0

        if has_failed:
            fail_x.append(life)
            fail_y.append(pc1_health[-1])
            fail_color.append(pc2_health[-1])  # PC2 at the failure cycle
        else:
            censored_count += 1

    # Removes the color artifact for PC2 if there is one operating condition.
    if fault_modes == 1:
        fail_color = '#800026'
        showscale = False
    else:
        showscale = True

    fig.add_scatter(
        x=fail_x,
        y=fail_y,
        mode="markers",
        name="Failure",
        marker=dict(
            symbol="x",
            size=10,
            color=fail_color,
            colorscale="YlOrRd_r",
            colorbar=dict(title="PC2 at failure"),
            showscale=showscale,
        ),
    )

    fig.update_layout(
        template="plotly_dark",
        title=f"Turbofan Jet Engine Degredation: {title} | Fault Modes: {fault_modes} | Censored: {censored_count}",
        xaxis_title="Operating Cycle",
        yaxis_title="Health Indicator (PC1)",
        showlegend=False,
        height=800,
    )

    fig.show()


def fault_distro(values):
    """ Shows the distribution of failures across multiple operating conditions

        Args:
            values (List): Fault occurrences for conditions in sequential order.
    """

    datasets = [
        'Condition 1',
        'Condition 2',
        'Condition 3',
        'Condition 4',
        'Condition 5',
        'Condition 6'
    ]

    fig = go.Figure(
        data=[go.Pie(
            labels=datasets,
            values=values,
            marker_colors=px.colors.sequential.Reds,
            title='Distribution of Faults Across Conditions',
        )],
    )

    fig.update_layout(height=600)
    fig.update_layout(template="plotly_dark")
    fig.show()


