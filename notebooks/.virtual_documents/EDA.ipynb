def correlation_view(df, dataset, engine_id=None, drop_constants=False):
    """ Displays the correlation between sensors for individual engines -
        or the entire fleet at once.

        Args:
            df (Pandas DataFrame): Target DataFrame containing data for
            visualizations.

            dataset (String): Name of the target DataFrame used for
            visualization.

            engine_id (Integer): Optional index for engine-specific correlation
            viewing.

            drop_constants (Bool): Specify whether or not to hide NaN correlation
            values that originate from constant sensor readout values.
    """

    sensors = eda_utils.dropcols(df)

    if engine_id is None:
        # View sensor correlations | all engines
        sensors = eda_utils.drop_constant_cols(sensors, drop_constants, engine_id)
        corr_matrix = sensors.corr()

        fig1 = px.imshow(
            corr_matrix,
            x=corr_matrix.columns,
            y=corr_matrix.index,
            labels={"x": "sensor", "y": "sensor", "color": "correlation"},
            text_auto=True,
            template="plotly_dark",
            title=f"""
                Sensor Correlation | All Engines | {dataset} | Constants Present: {drop_constants == False}
                """
        )

        fig1.update_layout(height=800)
        fig1.show()
    else:
        # View sensor correlations | individual engines
        sensors = eda_utils.drop_constant_cols(sensors, drop_constants, engine_id)
        corr_matrix = sensors.corr()

        fig2 = px.imshow(
            corr_matrix,
            x=corr_matrix.columns,
            y=corr_matrix.index,
            labels={"x": "sensor", "y": "sensor", "color": "correlation"},
            text_auto=True,
            template="plotly_dark",
            title=f"""
                Sensor Correlation | Engine: {engine_id} | Constants Present: {drop_constants == False}
                """
        )

        fig2.update_layout(height=800)
        fig2.show()





