def populateRUL(url, df):
    """ Populates the remaining useful life row for test sets.

        Args:
            url (String): taget url to create Pandas DataFrame.

        Returns:
            rul_values (Pandas DataFrame): The updated DataFrame with -
            Populated RUL values
    """
    RUL = pd.read_csv(
        url,
        sep=r' ',
        header=None,
        names=['RUL', 'NaN']
    )
    rul_values = [rul for rul in RUL['RUL']]
    df["RUL"] = np.nan
    last_rows_mask = df.groupby("Engine")["Time"].transform("max") == df["Time"]
    df.loc[last_rows_mask, "RUL"] = rul_values

    return df


